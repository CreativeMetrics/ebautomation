# Dati di runtime e configurazione sensibile: non vanno versionati.
# database.sqlite contiene tutti i dati applicativi (config con token API e
# password SMTP cifrati, regole, ordini, utenti); gli altri sono log o stato
# generato dall'app a runtime, non codice sorgente.
database.sqlite
database.sqlite-wal
database.sqlite-shm
secret.php
logo.png
webhook_log.txt
webhook_log_*.txt
audit_log.txt
trigger_events.txt
target_events.txt
backups/

# File di una precedente installazione basata su file JSON, rinominati
# automaticamente dopo la migrazione a SQLite (vedi migrate_legacy_json_if_needed
# in functions.php) — restano sul disco come riferimento ma non sono più letti.
*.json.migrated
config.json
regole_sconti.json
processed_orders.json
login_throttle.json
failed_orders.json
alert_state.json
users.json
